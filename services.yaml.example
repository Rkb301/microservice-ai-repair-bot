# Legacy four-service local fixture registry retained for existing CLI demos/tests.
# The project-aligned product boundary is services.mvp-review.example.yaml (three services).
services:
  - name: user-service
    application_name: user-api
    repo_path: examples/toy-java-microservices/user-service
    github_repo: owner/user-service
    build_tool: maven
    test_cmd: mvn test
    source_roots:
      - src/main/java
      - src/test/java
    log_file: logs/user-service.log
    base_url: http://localhost:8081

  - name: order-service
    application_name: order-api
    repo_path: examples/toy-java-microservices/order-service
    github_repo: owner/order-service
    build_tool: maven
    test_cmd: mvn test
    source_roots:
      - src/main/java
      - src/test/java
    log_file: logs/order-service.log
    base_url: http://localhost:8082

  - name: payment-service
    application_name: payment-api
    repo_path: examples/toy-java-microservices/payment-service
    github_repo: owner/payment-service
    build_tool: maven
    test_cmd: mvn test
    source_roots:
      - src/main/java
      - src/test/java
    log_file: logs/payment-service.log
    base_url: http://localhost:8083

  - name: inventory-service
    application_name: inventory-api
    repo_path: examples/toy-java-microservices/inventory-service
    github_repo: owner/inventory-service
    build_tool: maven
    test_cmd: mvn test
    source_roots:
      - src/main/java
      - src/test/java
    log_file: logs/inventory-service.log
    base_url: http://localhost:8084

